target/
*.proptest-regressions
__pycache__/
node_modules/
**/.rsui/react-compiler/

# What an app saves beside itself while it runs: its settings, and inspector traces. A trace holds the paths and values of
# whoever recorded it, so none belongs here.
rsui-storage/
*.rsuitrace

# Programs packed beside a demo go in a release, not the tree.
*.exe

# Left by a PowerShell run with its profile folder pointed here.
demos/*/Microsoft/

# Local measurements, which hold the paths of whoever ran them.
/performance-audit/
